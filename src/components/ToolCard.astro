---
import type { ToolEntry } from '../data/tool-inventory.schema';
interface Props { tool: ToolEntry }
const { tool } = Astro.props;

const sourceAppMeta: Record<string, { cls: string; glyph: string }> = {
  "pdf":       { cls: "b-pdf", glyph: "📑" },
  "image":     { cls: "b-img", glyph: "🖼" },
  "image-pro": { cls: "b-pro", glyph: "⚡" },
  "tools":     { cls: "b-dev", glyph: "🔧" },
};

const iconOverrides: Record<string, string> = {
  "qr-code-generator": "🔳",
  "password-generator": "🔐",
  "color-picker": "🎨",
};

const meta = sourceAppMeta[tool.source_app] ?? { cls: "b-dev", glyph: "🔧" };
const iconClass = meta.cls;
const iconGlyph = iconOverrides[tool.id] ?? meta.glyph;
---
<a class="card" href={tool.route} data-tool-id={tool.id} data-category={tool.source_app}>
  <div class="card-top">
    <div class={`card-icon ${iconClass}`}>{iconGlyph}</div>
    <div class="card-tag">{tool.category}</div>
  </div>
  <h4>{tool.title}</h4>
  <p>{tool.description}</p>
</a>
