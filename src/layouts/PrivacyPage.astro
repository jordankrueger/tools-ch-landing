---
import HomeLayout from './HomeLayout.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<HomeLayout title={`${title} — Tools by CampaignHelp`} description={description}>
  <article class="privacy-page">
    <header class="task-head">
      <p class="task-eyebrow">Privacy</p>
      <h1>{title}</h1>
      <p class="task-lede">{description}</p>
    </header>
    <section class="task-body">
      <slot />
    </section>
  </article>
</HomeLayout>

<style is:global>
  .privacy-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 64px 28px;
  }
  @media (max-width: 720px) {
    .privacy-page { padding: 48px 18px; }
  }
  .privacy-page .task-body h2 {
    font-size: 24px;
    margin: 36px 0 14px;
    color: var(--gray-900);
  }
  .privacy-page .task-body code {
    background: var(--gray-100);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 14px;
    color: var(--gray-800);
  }
</style>
